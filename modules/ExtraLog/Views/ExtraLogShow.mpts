<form>
    <div class="topBarButtons">
        <a href=("/ExtraLog/edit/":item.id) class="button action-edit"><span class="icon-edit"></span>{{t("CommonBase.edit")}}</a>
    </div>
    <div class="grid page-ExtraLog page-ExtraLog-show">
        <input name="id" type="hidden" />
        <section class=("card action-":type) data-width="6">
            <header>
                <h1>{{t("ExtraLog.ExtraLog.ExtraLog")}}</h1>
            </header>
          <div class="pseudoLabel">
            <span>{{t("ExtraLog.ExtraLog.project_id")}}:</span>
            <strong>{{item.project_id}}</strong>
        </div><div class="pseudoLabel">
            <span>{{t("ExtraLog.ExtraLog.pageOpenIdentifier")}}:</span>
            <strong>{{item.pageOpenIdentifier}}</strong>
        </div><div class="pseudoLabel">
            <span>{{t("ExtraLog.ExtraLog.added")}}:</span>
            <strong>{{item.added}}</strong>
        </div><div class="pseudoLabel">
            <span>{{t("ExtraLog.ExtraLog.source")}}:</span>
            <strong>{{item.source}}</strong>
        </div><div class="pseudoLabel">
            <span>{{t("ExtraLog.ExtraLog.type")}}:</span>
            <strong>{{item.type}}</strong>
        </div><div class="pseudoLabel">
            <span>{{t("ExtraLog.ExtraLog.data")}}:</span>
            <strong>{{item.data}}</strong>
        </div>
        </section>
    </div>
</form>