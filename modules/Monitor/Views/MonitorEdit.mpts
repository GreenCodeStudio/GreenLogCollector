<form>
    <div class="topBarButtons">
        <a href="/Monitor/" class="button"><span class="icon-cancel"></span>{{t("CommonBase.cancel")}}</a>
        <button class=("button action-":type)><span class="icon-save"></span>{{t("CommonBase.save")}}</button>
    </div>
    <div class="grid page-Monitor page-Monitor-edit">
        <input name="id" type="hidden" />
        <section class=("card action-":type) data-width="6">
            <header>
                <h1>{{t("Monitor.Monitor.Monitor")}}</h1>
            </header>
          <label>
            <span>{{t("Monitor.Monitor.name")}}</span>
            <input type="text" name="name"  />
        </label><label>
            <span>{{t("Monitor.Monitor.address")}}</span>
            <input type="text" name="address"  />
        </label><label>
            <span>{{t("Monitor.Monitor.type")}}</span>
            <input type="text" name="type" required />
        </label><label>
            <span>{{t("Monitor.Monitor.project_id")}}</span>
            <select data-foreign-key="project" name="project_id"  > </select>
        </label>
        </section>
    </div>
</form>