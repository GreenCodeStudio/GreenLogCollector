<form>
    <div class="topBarButtons">
        <a href=("/MonitorResult/edit/":item.id) class="button action-edit"><span class="icon-edit"></span>{{t("CommonBase.edit")}}</a>
    </div>
    <div class="grid page-MonitorResult page-MonitorResult-show">
        <input name="id" type="hidden" />
        <section class=("card action-":type) data-width="6">
            <header>
                <h1>{{t("Monitor.MonitorResult.MonitorResult")}}</h1>
            </header>
          <div class="pseudoLabel">
            <span>{{t("Monitor.MonitorResult.monitor_id")}}:</span>
            <strong>{{item.monitor_id}}</strong>
        </div><div class="pseudoLabel">
            <span>{{t("Monitor.MonitorResult.stamp")}}:</span>
            <strong>{{item.stamp}}</strong>
        </div><div class="pseudoLabel">
            <span>{{t("Monitor.MonitorResult.responseTime")}}:</span>
            <strong>{{item.responseTime}}</strong>
        </div><div class="pseudoLabel">
            <span>{{t("Monitor.MonitorResult.isSuccess")}}:</span>
            <strong>{{item.isSuccess}}</strong>
        </div><div class="pseudoLabel">
            <span>{{t("Monitor.MonitorResult.status")}}:</span>
            <strong>{{item.status}}</strong>
        </div>
        </section>
    </div>
</form>
