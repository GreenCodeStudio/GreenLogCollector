<form>
    <div class="topBarButtons">
        <a href=("/VisitLog/edit/":item.id) class="button action-edit"><span class="icon-edit"></span>{{t("CommonBase.edit")}}</a>
    </div>
    <div class="grid page-VisitLog page-VisitLog-show">
        <input name="id" type="hidden" />
        <section class="card action-show" data-width="6">
            <header>
                <h1>{{t("VisitLog.VisitLog.VisitLog")}}</h1>
            </header>
          <div class="pseudoLabel">
            <span>{{t("VisitLog.VisitLog.project_id")}}:</span>
            <strong><a href=links.project_id >{{item.project_id}}</a></strong>
        </div>
            <div class="pseudoLabel">
            <span>{{t("VisitLog.VisitLog.userIdentifier")}}:</span>
            <strong><a href=links.userIdentifier >{{item.userIdentifier}}</a></strong>
        </div>
            <div class="pseudoLabel">
            <span>{{t("VisitLog.VisitLog.userAgent")}}:</span>
            <strong><a href=links.userAgent >{{item.userAgent}}</a></strong>
        </div>
            <div class="pseudoLabel">
                <span>{{t("VisitLog.VisitLog.ipAddress")}}:</span>
                <strong><a href=links.ipAddress >{{item.ipAddress}}</a></strong>
            </div>
            <div class="pseudoLabel">
                <span>{{t("VisitLog.VisitLog.ipAddressIsBot")}}:</span>
                <strong>{{item.ipAddressIsBot}}</strong>
            </div>
            <div class="pseudoLabel">
                <span>{{t("VisitLog.VisitLog.ipAddressAbusive")}}:</span>
                <strong>{{item.ipAddressAbusive}}</strong>
            </div>
            <div class="pseudoLabel">
            <span>{{t("VisitLog.VisitLog.sessionIdentifier")}}:</span>
            <strong><a href=links.sessionIdentifier >{{item.sessionIdentifier}}</a></strong>
        </div>
            <div class="pseudoLabel">
            <span>{{t("VisitLog.VisitLog.pageOpenIdentifier")}}:</span>
            <strong><a href=links.pageOpenIdentifier >{{item.pageOpenIdentifier}}</a></strong>
        </div>
            <div class="pseudoLabel">
            <span>{{t("VisitLog.VisitLog.url")}}:</span>
            <strong><a href=links.url >{{item.url}}</a></strong>
        </div>
            <div class="pseudoLabel">
            <span>{{t("VisitLog.VisitLog.added")}}:</span>
            <strong>{{item.added}}</strong>
        </div>
            <div class="pseudoLabel">
                <span>{{t("VisitLog.VisitLog.type")}}:</span>
                <strong>{{item.type}}</strong>
            </div>
            <div class="pseudoLabel">
                <span>{{t("VisitLog.VisitLog.botProbability")}}:</span>
                <strong>{{item.botProbability}}</strong>
            </div>
        </section>
        <:if condition=item.extraLogs >
            <section class="card action-show" data-width="6">
                <:foreach collection=item.extraLogs item=extraLog>
                    <div>
                        <div class="pseudoLabel">
                            <span>created</span>
                            <strong>{{extraLog.created}}</strong>
                        </div>
                        <div class="pseudoLabel">
                            <span>source</span>
                            <strong>{{extraLog.source}}</strong>
                        </div>
                        <div class="pseudoLabel">
                            <span>type</span>
                            <strong>{{extraLog.type}}</strong>
                        </div>
                        <div class="pseudoLabel">
                            <span>data</span>
                            <pre>{{dump(extraLog.data)}}</pre>
                        </div>
                    </div>
                </:foreach>
            </section>
        </:if>
    </div>
</form>
