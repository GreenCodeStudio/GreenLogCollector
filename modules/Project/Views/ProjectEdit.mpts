<form>
    <div class="topBarButtons">
        <a href="/Project/" class="button"><span class="icon-cancel"></span>{{t("CommonBase.cancel")}}</a>
        <button class=("button action-":type)><span class="icon-save"></span>{{t("CommonBase.save")}}</button>
    </div>
    <div class="grid page-Project page-Project-edit">
        <input name="id" type="hidden" />
        <section class=("card action-":type) data-width="6">
            <header>
                <h1>{{t("Project.Project.Project")}}</h1>
            </header>
          <label>
            <span>{{t("Project.Project.name")}}</span>
            <input type="text" name="name"  />
        </label>
        </section>
    </div>
</form>