<form>
    <div class="topBarButtons">
        <a href=("/Project/edit/":item.id) class="button action-edit"><span class="icon-edit"></span>{{t("CommonBase.edit")}}</a>
    </div>
    <div class="grid page-Project page-Project-show">
        <input name="id" type="hidden" />
        <section class=("card action-":type) data-width="6">
            <header>
                <h1>{{t("Project.Project.Project")}}</h1>
            </header>
          <div class="pseudoLabel">
            <span>{{t("Project.Project.name")}}:</span>
            <strong>{{item.name}}</strong>
        </div>
        </section>
    </div>
</form>